# Telegram Bot Token
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Books API Key (optional but recommended for better results)
# Get from: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=your_google_books_api_key_here

# Hardcover.app API Key for community ratings
# Get from: https://hardcover.app/settings/api
HARDCOVER_API_KEY=your_hardcover_api_key_here

# Azure Translator (optional; used only for non-English book descriptions)
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=your_azure_translator_region_here

# Telegram user ID of the bot owner (exempt from cancellation abuse limits)
# Get by messaging @userinfobot on Telegram
BOT_OWNER_ID=your_telegram_user_id_here
